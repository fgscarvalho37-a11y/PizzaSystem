spring.application.name=backend

# =========================
# BANCO DE DADOS
# =========================

spring.datasource.url=jdbc:postgresql://localhost:5432/pizzasystem
spring.datasource.username=postgres
spring.datasource.password=${DB_PASSWORD:}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true


# =========================
# MERCADO PAGO
# =========================

# Assinatura dos Webhooks
mercadopago.webhook-secret=${MERCADOPAGO_WEBHOOK_SECRET:}

# OAuth - conexão da conta Mercado Pago de cada estabelecimento
mercadopago.oauth.client-id=${MERCADOPAGO_CLIENT_ID:}
mercadopago.oauth.client-secret=${MERCADOPAGO_CLIENT_SECRET:}
mercadopago.oauth.redirect-uri=${MERCADOPAGO_REDIRECT_URI:}

# =========================
# SUPABASE STORAGE
# =========================

# Imagens de logo, capa e produtos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PIZZASYSTEM_STORAGE_BUCKET=pizzasystem-assets

# Deixe false em produção para impedir imagens Base64 no PostgreSQL.
PIZZASYSTEM_ALLOW_DATABASE_IMAGE_FALLBACK=false

# Uploads de logo/capa/produto
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=6MB

# ===============================
# STRIPE CONNECT - PAGAMENTOS DAS LOJAS INTERNACIONAIS
# ===============================
# Configuração única da plataforma Orbitta/PizzaSystem.
# As pizzarias NÃO informam chaves: usam o botão "Conectar com Stripe".
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_ONBOARDING_RETURN_URI=https://pizzasystem-api.onrender.com/api/admin/stripe-payment/onboarding/return
STRIPE_CONNECT_ONBOARDING_REFRESH_URI=https://pizzasystem-api.onrender.com/api/admin/stripe-payment/onboarding/refresh

stripe.connect.secret-key=${STRIPE_CONNECT_SECRET_KEY:}
stripe.connect.publishable-key=${STRIPE_CONNECT_PUBLISHABLE_KEY:}
stripe.connect.webhook-secret=${STRIPE_CONNECT_WEBHOOK_SECRET:}
stripe.connect.onboarding-return-uri=${STRIPE_CONNECT_ONBOARDING_RETURN_URI:https://pizzasystem-api.onrender.com/api/admin/stripe-payment/onboarding/return}
stripe.connect.onboarding-refresh-uri=${STRIPE_CONNECT_ONBOARDING_REFRESH_URI:https://pizzasystem-api.onrender.com/api/admin/stripe-payment/onboarding/refresh}

# Mantido apenas para compatibilidade com conexões antigas por chave.
PIZZASYSTEM_CREDENTIAL_ENCRYPTION_KEY=

PIZZASYSTEM_PUBLIC_API_URL=https://pizzasystem-api.onrender.com
PIZZASYSTEM_PUBLIC_APP_URL=https://pizzasystem.orbitta.space

# ===============================
# PAYPAL PLATFORM - PAGAMENTOS DAS LOJAS INTERNACIONAIS
# ===============================
# Configuração única da Orbitta/PizzaSystem. As pizzarias usam
# "Conectar com PayPal" e nunca informam Client ID ou Client Secret.
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_PLATFORM_SANDBOX=true
PAYPAL_ONBOARDING_RETURN_URL=https://pizzasystem-api.onrender.com/api/admin/paypal-payment/onboarding/return

paypal.platform.client-id=${PAYPAL_PLATFORM_CLIENT_ID:}
paypal.platform.client-secret=${PAYPAL_PLATFORM_CLIENT_SECRET:}
paypal.platform.partner-merchant-id=${PAYPAL_PARTNER_MERCHANT_ID:}
paypal.platform.partner-attribution-id=${PAYPAL_PARTNER_ATTRIBUTION_ID:}
paypal.platform.sandbox=${PAYPAL_PLATFORM_SANDBOX:true}
paypal.platform.return-url=${PAYPAL_ONBOARDING_RETURN_URL:https://pizzasystem-api.onrender.com/api/admin/paypal-payment/onboarding/return}
