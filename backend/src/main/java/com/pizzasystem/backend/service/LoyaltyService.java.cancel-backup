package com.pizzasystem.backend.service;

import com.pizzasystem.backend.entity.Customer;
import com.pizzasystem.backend.entity.LoyaltyAccount;
import com.pizzasystem.backend.entity.LoyaltyEarningType;
import com.pizzasystem.backend.entity.LoyaltyRedemption;
import com.pizzasystem.backend.entity.LoyaltyTransaction;
import com.pizzasystem.backend.entity.Order;
import com.pizzasystem.backend.entity.PaymentStatus;
import com.pizzasystem.backend.entity.Store;

import com.pizzasystem.backend.repository.LoyaltyAccountRepository;
import com.pizzasystem.backend.repository.LoyaltyRedemptionRepository;
import com.pizzasystem.backend.repository.LoyaltyTransactionRepository;
import com.pizzasystem.backend.repository.OrderRepository;

import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.math.BigDecimal;
import java.math.RoundingMode;

@Service
public class LoyaltyService {

    private final LoyaltyAccountRepository
            loyaltyAccountRepository;

    private final LoyaltyTransactionRepository
            loyaltyTransactionRepository;

    private final LoyaltyRedemptionRepository
            loyaltyRedemptionRepository;

    private final OrderRepository
            orderRepository;

    public LoyaltyService(
            LoyaltyAccountRepository loyaltyAccountRepository,
            LoyaltyTransactionRepository loyaltyTransactionRepository,
            LoyaltyRedemptionRepository loyaltyRedemptionRepository,
            OrderRepository orderRepository
    ) {

        this.loyaltyAccountRepository =
                loyaltyAccountRepository;

        this.loyaltyTransactionRepository =
                loyaltyTransactionRepository;

        this.loyaltyRedemptionRepository =
                loyaltyRedemptionRepository;

        this.orderRepository =
                orderRepository;
    }

    // =========================
    // REGISTRAR FIDELIDADE
    // =========================

    @Transactional
    public void registerForOrder(
            Order order
    ) {

        if (order == null
                || order.getId() == null) {

            System.out.println(
                    "[LOYALTY] PAROU: pedido nulo ou sem ID"
            );

            return;
        }

        System.out.println(
                "[LOYALTY] Iniciando pedido #"
                        + order.getId()
        );

        System.out.println(
                "[LOYALTY] paymentStatus = "
                        + order.getPaymentStatus()
        );

        System.out.println(
                "[LOYALTY] loyaltyRegistered = "
                        + order.isLoyaltyRegistered()
        );

        // =========================
        // SOMENTE PEDIDO APROVADO
        // =========================

        if (order.getPaymentStatus()
                != PaymentStatus.APPROVED) {

            System.out.println(
                    "[LOYALTY] PAROU: pagamento não está APPROVED"
            );

            return;
        }

        // =========================
        // JÁ PROCESSADO
        // =========================

        if (order.isLoyaltyRegistered()) {

            System.out.println(
                    "[LOYALTY] PAROU: pedido já marcado como registrado"
            );

            return;
        }

        if (loyaltyTransactionRepository
                .existsByOrderId(
                        order.getId()
                )) {

            order.setLoyaltyRegistered(
                    true
            );

            orderRepository.save(
                    order
            );

            System.out.println(
                    "[LOYALTY] PAROU: já existe transação para o pedido"
            );

            return;
        }

        // =========================
        // CLIENTE
        // =========================

        Customer customer =
                order.getCustomer();

        /*
         * Compra como visitante
         * não participa da fidelidade.
         */
        System.out.println(
                "[LOYALTY] customerId = "
                        + (
                        customer != null
                                ? customer.getId()
                                : null
                )
        );

        if (customer == null
                || customer.getId() == null) {

            System.out.println(
                    "[LOYALTY] PAROU: pedido sem cliente autenticado"
            );

            return;
        }

        // =========================
        // LOJA
        // =========================

        Store store =
                order.getStore();

        System.out.println(
                "[LOYALTY] storeId = "
                        + (
                        store != null
                                ? store.getId()
                                : null
                )
        );

        if (store == null
                || store.getId() == null) {

            System.out.println(
                    "[LOYALTY] PAROU: pedido sem loja"
            );

            return;
        }

        // =========================
        // FIDELIDADE ATIVA?
        // =========================

        System.out.println(
                "[LOYALTY] loyaltyEnabled = "
                        + store.isLoyaltyEnabled()
        );

        if (!store.isLoyaltyEnabled()) {

            System.out.println(
                    "[LOYALTY] PAROU: fidelidade desativada"
            );

            return;
        }

        // =========================
        // VALOR MÍNIMO
        // =========================

        BigDecimal orderTotal =
                order.getTotal();

        System.out.println(
                "[LOYALTY] total = "
                        + orderTotal
        );

        if (orderTotal == null) {

            System.out.println(
                    "[LOYALTY] PAROU: pedido sem total"
            );

            return;
        }

        BigDecimal minimumOrderValue =
                store.getLoyaltyMinimumOrderValue();

        System.out.println(
                "[LOYALTY] minimumOrderValue = "
                        + minimumOrderValue
        );

        if (minimumOrderValue != null
                && orderTotal.compareTo(
                        minimumOrderValue
                ) < 0) {

            System.out.println(
                    "[LOYALTY] PAROU: total abaixo do mínimo"
            );

            return;
        }

        // =========================
        // CALCULAR PONTOS
        // =========================

        int earnedPoints =
                calculatePoints(
                        store,
                        orderTotal
                );

        System.out.println(
                "[LOYALTY] earningType = "
                        + store.getLoyaltyEarningType()
        );

        System.out.println(
                "[LOYALTY] amountStep = "
                        + store.getLoyaltyAmountStep()
        );

        System.out.println(
                "[LOYALTY] pointsPerAmountStep = "
                        + store.getLoyaltyPointsPerAmountStep()
        );

        System.out.println(
                "[LOYALTY] pointsPerOrder = "
                        + store.getLoyaltyPointsPerOrder()
        );

        System.out.println(
                "[LOYALTY] earnedPoints = "
                        + earnedPoints
        );

        if (earnedPoints <= 0) {

            System.out.println(
                    "[LOYALTY] PAROU: cálculo retornou zero pontos"
            );

            return;
        }

        // =========================
        // BUSCAR / CRIAR CONTA
        // =========================

        LoyaltyAccount account =
                loyaltyAccountRepository
                        .findByCustomerIdAndStoreId(
                                customer.getId(),
                                store.getId()
                        )
                        .orElseGet(
                                () ->
                                        createAccount(
                                                customer,
                                                store
                                        )
                        );

        int currentPoints =
                account.getPoints() != null
                        ? account.getPoints()
                        : 0;

        int currentLifetimePoints =
                account.getLifetimePoints() != null
                        ? account.getLifetimePoints()
                        : 0;

        account.setPoints(
                currentPoints
                        + earnedPoints
        );

        account.setLifetimePoints(
                currentLifetimePoints
                        + earnedPoints
        );

        account =
                loyaltyAccountRepository
                        .save(
                                account
                        );

        // =========================
        // TRANSAÇÃO
        // =========================

        LoyaltyTransaction transaction =
                new LoyaltyTransaction();

        transaction.setLoyaltyAccount(
                account
        );

        transaction.setOrder(
                order
        );

        transaction.setPoints(
                earnedPoints
        );

        transaction.setType(
                "ORDER_REWARD"
        );

        transaction.setDescription(
                buildDescription(
                        store,
                        earnedPoints
                )
        );

        loyaltyTransactionRepository.save(
                transaction
        );

        // =========================
        // MARCAR PEDIDO
        // =========================

        order.setLoyaltyRegistered(
                true
        );

        orderRepository.save(
                order
        );

        System.out.println(
                "Fidelidade registrada para pedido #"
                        + order.getId()
                        + " | cliente: "
                        + customer.getId()
                        + " | loja: "
                        + store.getId()
                        + " | pontos: "
                        + earnedPoints
        );
    }

    // =========================
    // RESGATAR RECOMPENSA
    // =========================

    /*
     * Realiza um resgate da recompensa
     * configurada pela loja.
     *
     * O cliente precisa possuir pelo menos
     * loyaltyStampGoal pontos disponíveis.
     *
     * O resgate:
     *
     * - reduz o saldo atual;
     * - NÃO reduz lifetimePoints;
     * - incrementa rewardsRedeemed;
     * - cria uma transação negativa;
     * - cria uma recompensa PENDING;
     * - não exige pedido associado.
     */
    @Transactional
    public LoyaltyTransaction redeemReward(
            Long customerId,
            Long storeId
    ) {

        // =========================
        // IDs
        // =========================

        if (customerId == null) {

            throw new IllegalArgumentException(
                    "Cliente não informado."
            );
        }

        if (storeId == null) {

            throw new IllegalArgumentException(
                    "Loja não informada."
            );
        }

        // =========================
        // CONTA
        // =========================

        LoyaltyAccount account =
                loyaltyAccountRepository
                        .findByCustomerIdAndStoreId(
                                customerId,
                                storeId
                        )
                        .orElseThrow(
                                () ->
                                        new IllegalStateException(
                                                "Você ainda não possui pontos nesta loja."
                                        )
                        );

        // =========================
        // SEGURANÇA DA CONTA
        // =========================

        Customer customer =
                account.getCustomer();

        if (customer == null
                || customer.getId() == null
                || !customerId.equals(
                        customer.getId()
                )) {

            throw new IllegalStateException(
                    "Conta de fidelidade inválida."
            );
        }

        Store store =
                account.getStore();

        if (store == null
                || store.getId() == null
                || !storeId.equals(
                        store.getId()
                )) {

            throw new IllegalStateException(
                    "Loja da fidelidade inválida."
            );
        }

        // =========================
        // FIDELIDADE ATIVA
        // =========================

        if (!store.isLoyaltyEnabled()) {

            throw new IllegalStateException(
                    "O programa de fidelidade desta loja está desativado."
            );
        }

        // =========================
        // META
        // =========================

        Integer stampGoal =
                store.getLoyaltyStampGoal();

        if (stampGoal == null
                || stampGoal <= 0) {

            throw new IllegalStateException(
                    "A loja ainda não configurou uma meta válida para a recompensa."
            );
        }

        // =========================
        // RECOMPENSA
        // =========================

        String rewardDescription =
                store.getLoyaltyRewardDescription();

        if (rewardDescription == null
                || rewardDescription.isBlank()) {

            throw new IllegalStateException(
                    "A loja ainda não configurou a recompensa da fidelidade."
            );
        }

        rewardDescription =
                rewardDescription.trim();

        // =========================
        // SALDO
        // =========================

        int currentPoints =
                account.getPoints() != null
                        ? account.getPoints()
                        : 0;

        if (currentPoints < stampGoal) {

            int missingPoints =
                    stampGoal
                            - currentPoints;

            String unit =
                    missingPoints == 1
                            ? "ponto"
                            : "pontos";

            throw new IllegalStateException(
                    "Faltam "
                            + missingPoints
                            + " "
                            + unit
                            + " para resgatar esta recompensa."
            );
        }

        // =========================
        // TOTAL DE RESGATES
        // =========================

        int currentRewardsRedeemed =
                account.getRewardsRedeemed() != null
                        ? account.getRewardsRedeemed()
                        : 0;

        // =========================
        // DESCONTAR PONTOS
        // =========================

        account.setPoints(
                currentPoints
                        - stampGoal
        );

        /*
         * lifetimePoints representa tudo
         * que o cliente já conquistou.
         *
         * Por isso NÃO é reduzido
         * durante o resgate.
         */

        account.setRewardsRedeemed(
                currentRewardsRedeemed
                        + 1
        );

        account =
                loyaltyAccountRepository
                        .save(
                                account
                        );

        // =========================
        // TRANSAÇÃO DE RESGATE
        // =========================

        LoyaltyTransaction transaction =
                new LoyaltyTransaction();

        transaction.setLoyaltyAccount(
                account
        );

        /*
         * Resgate não está associado
         * diretamente a um pedido.
         */
        transaction.setOrder(
                null
        );

        transaction.setPoints(
                -stampGoal
        );

        transaction.setType(
                "REWARD_REDEMPTION"
        );

        transaction.setDescription(
                buildRedemptionDescription(
                        store,
                        stampGoal,
                        rewardDescription
                )
        );

        transaction =
                loyaltyTransactionRepository
                        .save(
                                transaction
                        );

        // =========================
        // RECOMPENSA PENDENTE
        // =========================

        LoyaltyRedemption redemption =
                new LoyaltyRedemption();

        redemption.setCustomer(
                customer
        );

        redemption.setStore(
                store
        );

        redemption.setLoyaltyAccount(
                account
        );

        redemption.setPointsUsed(
                stampGoal
        );

        /*
         * Salva uma cópia da recompensa
         * atual da loja.
         *
         * Se a configuração mudar depois,
         * este resgate continua preservando
         * o benefício original.
         */
        redemption.setRewardDescription(
                rewardDescription
        );

        redemption.setStatus(
                "PENDING"
        );

        redemption =
                loyaltyRedemptionRepository
                        .save(
                                redemption
                        );

        System.out.println(
                "[LOYALTY] RECOMPENSA RESGATADA"
                        + " | cliente: "
                        + customerId
                        + " | loja: "
                        + storeId
                        + " | pontos utilizados: "
                        + stampGoal
                        + " | recompensa: "
                        + rewardDescription
                        + " | redemptionId: "
                        + redemption.getId()
                        + " | status: "
                        + redemption.getStatus()
        );

        return transaction;
    }

    // =========================
    // CALCULAR PONTOS
    // =========================

    private int calculatePoints(
            Store store,
            BigDecimal orderTotal
    ) {

        LoyaltyEarningType earningType =
                store.getLoyaltyEarningType();

        if (earningType == null) {

            earningType =
                    LoyaltyEarningType.PER_ORDER;
        }

        if (earningType
                == LoyaltyEarningType.PER_ORDER) {

            Integer pointsPerOrder =
                    store.getLoyaltyPointsPerOrder();

            if (pointsPerOrder == null
                    || pointsPerOrder <= 0) {

                return 0;
            }

            return pointsPerOrder;
        }

        // =========================
        // PER_AMOUNT
        // =========================

        BigDecimal amountStep =
                store.getLoyaltyAmountStep();

        Integer pointsPerStep =
                store.getLoyaltyPointsPerAmountStep();

        if (amountStep == null
                || amountStep.compareTo(
                        BigDecimal.ZERO
                ) <= 0) {

            return 0;
        }

        if (pointsPerStep == null
                || pointsPerStep <= 0) {

            return 0;
        }

        BigDecimal steps =
                orderTotal.divide(
                        amountStep,
                        0,
                        RoundingMode.DOWN
                );

        int completedSteps =
                steps.intValue();

        if (completedSteps <= 0) {

            return 0;
        }

        return completedSteps
                * pointsPerStep;
    }

    // =========================
    // CRIAR CONTA
    // =========================

    private LoyaltyAccount createAccount(
            Customer customer,
            Store store
    ) {

        LoyaltyAccount account =
                new LoyaltyAccount();

        account.setCustomer(
                customer
        );

        account.setStore(
                store
        );

        account.setPoints(
                0
        );

        account.setLifetimePoints(
                0
        );

        account.setRewardsRedeemed(
                0
        );

        return loyaltyAccountRepository
                .save(
                        account
                );
    }

    // =========================
    // DESCRIÇÃO DE CRÉDITO
    // =========================

    private String buildDescription(
            Store store,
            int earnedPoints
    ) {

        String unit =
                earnedPoints == 1
                        ? "ponto"
                        : "pontos";

        return earnedPoints
                + " "
                + unit
                + " por pedido aprovado em "
                + store.getName();
    }

    // =========================
    // DESCRIÇÃO DE RESGATE
    // =========================

    private String buildRedemptionDescription(
            Store store,
            int redeemedPoints,
            String rewardDescription
    ) {

        String unit =
                redeemedPoints == 1
                        ? "ponto"
                        : "pontos";

        return redeemedPoints
                + " "
                + unit
                + " utilizados para resgatar "
                + rewardDescription.trim()
                + " em "
                + store.getName();
    }
}